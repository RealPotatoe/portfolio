---
interface Props {
  title: string;
  center?: boolean;
}

const { title, center = false } = Astro.props;
---

<h2
  class:list={['font-display text-4xl leading-tight font-semibold', center && 'text-center']}
  set:html={title}
/>
<span class:list={['squiggle mt-3 mb-8', center && 'mx-auto']} aria-hidden="true"></span>
