---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { useTranslations, pick } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = (await getCollection('timeline')).sort((a, b) => a.data.order - b.data.order);
---

<section id="experience" class="reveal py-24">
  <div class="mx-auto max-w-[1120px] px-8">
    <SectionHeading title={t('experience.title')} center />

    <div class="relative mx-auto flex max-w-[760px] flex-col gap-8">
      <span
        class="absolute top-2 bottom-2 left-[15px] w-0.5 bg-edge"
        aria-hidden="true"
      ></span>

      {
        entries.map(({ data }) => (
          <div class="relative pl-16">
            <div
              class:list={[
                'absolute top-0 left-0 flex size-8 items-center justify-center rounded-full border-2 text-[0.85rem]',
                data.current
                  ? 'border-coral bg-coral-soft text-coral'
                  : 'border-edge bg-surface text-slate',
              ]}
            >
              <i class={data.icon} />
            </div>

            <div class="rounded-md border border-edge bg-surface p-6 shadow-card">
              <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                <span class="font-mono text-[0.78rem] text-slate">{pick(data.date, lang)}</span>
                {data.current && (
                  <span class="font-mono text-[0.72rem] font-semibold tracking-[0.03em] text-green">
                    ● {t('experience.present')}
                  </span>
                )}
              </div>

              <h3 class="font-display mb-1 text-[1.15rem] font-semibold">{pick(data.title, lang)}</h3>
              <p class="text-[0.9rem] italic text-slate">{pick(data.company, lang)}</p>

              {data.milestone && (
                <div class="mt-4 rounded-sm border-l-4 border-coral bg-coral-soft p-3">
                  <p class="text-[0.9em]" set:html={pick(data.milestone, lang)} />
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
