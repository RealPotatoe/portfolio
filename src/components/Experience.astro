---
import { getCollection } from "astro:content";
import type { Lang } from "../i18n/ui";
import { useTranslations, pick } from "../i18n/utils";
import SectionHeading from "./SectionHeading.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = (await getCollection("timeline")).sort((a, b) => a.data.order - b.data.order);
---

<section id="experience" class="reveal py-24">
    <div class="mx-auto max-w-6xl px-8">
        <SectionHeading title={t("experience.title")} center />

        <div class="relative mx-auto flex max-w-3xl flex-col gap-8">
            <span class="absolute top-2 bottom-2 left-[15px] w-0.5 bg-edge" aria-hidden="true"
            ></span>

            {
                entries.map(({ data }) => (
                    <div class="relative pl-16">
                        <div
                            class:list={[
                                "absolute top-0 left-0 flex size-8 items-center justify-center rounded-full border-2 text-sm",
                                data.current
                                    ? "border-coral bg-coral-soft text-coral-text"
                                    : "border-edge bg-surface text-slate",
                            ]}
                        >
                            <i class={data.icon} />
                        </div>

                        <div class="rounded-md border border-edge bg-surface p-6 shadow-card">
                            <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                                <span class="font-mono text-xs text-slate">
                                    {pick(data.date, lang)}
                                </span>
                                {data.current && (
                                    <span class="font-mono text-xs font-semibold tracking-wide text-green">
                                        ● {t("experience.present")}
                                    </span>
                                )}
                            </div>

                            <h3 class="mb-1 font-display text-lg font-semibold">
                                {pick(data.title, lang)}
                            </h3>
                            <p class="text-sm text-slate italic">{pick(data.company, lang)}</p>

                            {data.milestone && (
                                <div class="mt-4 rounded-sm border-l-4 border-coral bg-coral-soft p-3">
                                    <p class="text-sm" set:html={pick(data.milestone, lang)} />
                                </div>
                            )}

                            {(data.highlights || data.detail) && (
                                <>
                                    <hr class="my-4 border-edge" />

                                    {data.highlights && (
                                        <ul class="mb-2 space-y-2 text-sm">
                                            {pick(data.highlights, lang).map((highlight) => (
                                                <li class="flex gap-2">
                                                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-coral" />
                                                    <span>{highlight}</span>
                                                </li>
                                            ))}
                                        </ul>
                                    )}

                                    {data.detail && (
                                        <p class="text-sm">
                                            {data.detail_label && (
                                                <strong class="text-slate">
                                                    {pick(data.detail_label, lang)}{" "}
                                                </strong>
                                            )}
                                            <span class="text-slate">
                                                {pick(data.detail, lang)}
                                            </span>
                                        </p>
                                    )}
                                </>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
